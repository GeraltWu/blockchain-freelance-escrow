		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"approveMilestone(uint256,uint256)": {
					"notice": "Client 批准并放款:资金释放给 Freelancer(approve 与 release 同一笔交易)"
				},
				"createEscrow(address,uint256,string[],uint256[])": {
					"notice": "Client 创建项目(只登记结构,不转账)"
				},
				"fundEscrow(uint256)": {
					"notice": "Client 一次性全额存入资金,项目进入 FUNDED"
				},
				"raiseDispute(uint256,uint256)": {
					"notice": "Client 或 Freelancer 对已提交的 milestone 发起争议"
				},
				"refund(uint256,uint256)": {
					"notice": "超时退款:截止日后,Client 可对一直未提交的 milestone 拿回对应资金"
				},
				"resolveDispute(uint256,uint256,bool)": {
					"notice": "Arbitrator 裁决:releaseToFreelancer=true 放款给 Freelancer,否则退款给 Client"
				},
				"submitMilestone(uint256,uint256)": {
					"notice": "Freelancer 提交某个 milestone 的成果"
				}
			},
			"notice": "资金托管与条件式付款的链上实现。         状态机与数据模型见 docs/data-model.md,函数签名与校验规则见 docs/api-spec.md「B. Smart Contract 接口」。         核心原则(初步设计.md 十七):合约不信任前端,所有关键校验在合约内重做;         资金真相只存在于本合约,SQLite 仅是链下展示镜像。",
			"version": 1
		}
